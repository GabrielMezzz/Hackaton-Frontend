# Copia este archivo como server/.env y completa los valores.

# Proveedor del probador con IA: cloudflare | pollinations
IA_PROVEEDOR=cloudflare

# Cloudflare Workers AI . El token debe ser de ESTA cuenta,
# con la plantilla "Workers AI" (panel > Mi perfil > API Tokens).
CF_ACCOUNT_ID=
CF_API_TOKEN=
# El modelo de edicion mas liviano (~150 neuronas por imagen, ~65 al dia gratis)
CF_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Probador con IA: Pollinations (https://pollinations.ai), edicion con imagenes de referencia.
# POLLINATIONS_API_KEY: clave SECRETA (empieza con sk_) creada en https://enter.pollinations.ai/keys
#                       NUNCA la subas a git ni la pongas en la pagina.
POLLINATIONS_API_KEY=
# Modelo (debe aceptar 2+ imagenes de referencia; lista en https://gen.pollinations.ai/image/models):
#   black-forest-labs/flux.2-klein-4b  el mas barato (~0.005 pollen por imagen)   <- por defecto
#   openai/gpt-image-1.5 / openai/gpt-image-2   mas fieles con la identidad, mas caros
POLLINATIONS_MODEL=black-forest-labs/flux.2-klein-4b
# Calidad: low | medium | high
POLLINATIONS_QUALITY=high

# Pruebas con IA por IP y por dia (fecha de la zona horaria indicada)
PRUEBAS_POR_DIA=2
ZONA_HORARIA=America/Lima

PORT=8080

# Webhook de n8n para cotizaciones automáticas (asistente de pedidos)
WEBHOOK_ORDER_URL=http://169.58.74.99:5678/webhook-test/web-order

# URL real del frontend. El servidor reemplaza el placeholder "catalog_url"
# que devuelve n8n (cuando el usuario no envía datos) por esta URL.
FRONTEND_URL=https://angibellcreaciones.com

# Pon 1 si el servidor esta detras de un proxy (Render, Railway, Nginx, Cloudflare)
# para leer la IP real del cliente desde X-Forwarded-For.
TRUST_PROXY=0

# Base de datos PostgreSQL de la tienda (esquema en ../db).
# Ej. Remoto:
# DATABASE_URL=postgres://mipyme_user:tu_clave@169.58.74.99:5432/mipyme
# DB_AUTO_INIT=0 (1 = intenta correr schema.sql y seed.sql; 0 = solo consulta tablas existentes)
DATABASE_URL=postgres://mipyme_user:tu_clave@169.58.74.99:5432/mipyme
DB_AUTO_INIT=0
# Pon 1 si tu proveedor exige SSL (Supabase, Neon, Render...)
PGSSL=0


{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "/api/index?ruta=:ruta*" },
    { "source": "/", "destination": "/Angibellcreaciones.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "db/**"
    }
  },
  "headers": [
    { "source": "/Angibellcreaciones.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
